# Copiar este archivo a ".env" en la misma carpeta y completar lo que
# corresponda. No es necesario nada pago: todo corre en contenedores
# locales. Este archivo de ejemplo no debe llevar valores reales.

POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente
POSTGRES_DB=asistente

OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Solo hacen falta cuando se ejecute la sincronización con Drive (ver
# local-stack/README.md, sección "Google Drive"). La API de Drive es
# gratuita dentro de su cuota normal; no es una suscripción.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_SITIO_WEB_FOLDER_ID=
